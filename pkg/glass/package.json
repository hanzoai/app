{
  "name": "@hanzo/glass",
  "version": "0.1.1",
  "description": "Liquid glass and specular refraction for Hanzo UI widgets, as @hanzo/gui props.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./LiquidGlass": {
      "types": "./dist/LiquidGlass.d.ts",
      "import": "./dist/LiquidGlass.js",
      "default": "./dist/LiquidGlass.js"
    }
  },
  "license": "Apache-2.0 OR MIT",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ../app/scripts/specifiers.mjs ./dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@hanzo/gui": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "@hanzo/gui": "^8.3.5"
  }
}
